[Unit]
Description=Lock before sleep / power monitors on resume (swayidle)
# Pulled in by thomas-shell.service (Wants=) and tied to it with PartOf, so it
# follows the shell's start/stop/restart — it only exists to drive the shell's
# lockscreen over `qs ipc`.
PartOf=thomas-shell.service graphical-session.target
After=thomas-shell.service graphical-session.target

[Service]
# The `qs ipc call ...` command below finds the running shell through
# QS_CONFIG_PATH from the user manager's environment (see thomas-shell.service).
ExecStart=swayidle -w \
    after-resume 'niri msg action power-on-monitors' \
    before-sleep 'qs ipc call lockscreen lock'
Restart=on-failure
RestartSec=1
